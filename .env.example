# Todo App 로컬 환경변수 예시
#
# 로컬 실행 전에 이 파일을 `.env`로 복사한다.
# cp .env.example .env
#
# API 서버는 `npm run api:dev` 또는 `npm run api:start` 실행 시
# 저장소 루트의 `.env`를 읽는다.

# 로컬 화면 흐름 확인 모드: 실제 메일을 발송하지 않는다.
# 이메일 인증 코드는 333333으로 입력한다.
SMTP_TRANSPORT=stream
SMTP_FROM="Todo App <no-reply@example.com>"
AUTH_EMAIL_VERIFICATION_DIGIT=3

# Auth token 설정.
AUTH_JWT_SECRET=replace-with-a-local-secret
AUTH_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
AUTH_REFRESH_TOKEN_EXPIRES_IN_DAYS=30
AUTH_EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=10

# 실제 Gmail / Google Workspace SMTP 발송 예시.
# 이 설정을 쓰려면 위의 SMTP_TRANSPORT=stream을 제거하거나 주석 처리하고,
# 아래 SMTP 값을 실제 계정 기준으로 설정한다.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=dongjay@bigvalue.co.kr
# SMTP_PASS=google-app-password
# SMTP_FROM="Todo App <dongjay@bigvalue.co.kr>"
