# Todo App local environment example
#
# Copy this file to `.env` for local runs:
# cp .env.example .env
#
# The API server loads `.env` from the repository root when running
# `npm run api:dev` or `npm run api:start`.

# Local screen-flow mode: no real email is sent.
# Email verification code becomes 333333.
SMTP_TRANSPORT=stream
SMTP_FROM="Todo App <no-reply@example.com>"
AUTH_EMAIL_VERIFICATION_DIGIT=3

# Auth token settings.
AUTH_JWT_SECRET=replace-with-a-local-secret
AUTH_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
AUTH_REFRESH_TOKEN_EXPIRES_IN_DAYS=30
AUTH_EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=10

# Real Gmail / Google Workspace SMTP example.
# To use this, remove or comment out SMTP_TRANSPORT=stream above,
# then set the SMTP values below.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=dongjay@bigvalue.co.kr
# SMTP_PASS=your-google-app-password
# SMTP_FROM="Todo App <dongjay@bigvalue.co.kr>"
