{
  "name": "todo-app",
  "version": "0.0.0",
  "private": true,
  "description": "AI Agent와 함께 실무형 개발 과정을 연습하는 Todo App입니다.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm --workspace @todo-app/api run dev",
    "web:build": "npm --workspace @todo-app/web run build",
    "web:dev": "npm --workspace @todo-app/web run dev",
    "check": "npm run workspaces:list && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "workspaces:list": "npm --workspaces pkg get name"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@nestjs/testing": "^11.1.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@hookform/resolvers": "^5.2.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "pretendard": "^1.3.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-router": "^7.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
