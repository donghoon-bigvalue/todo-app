{
  "name": "todo-app",
  "version": "0.0.0",
  "private": true,
  "description": "AI Agent와 함께 실무형 개발 과정을 연습하는 Todo App입니다.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run workspaces:list && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "workspaces:list": "npm --workspaces pkg get name"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  }
}
